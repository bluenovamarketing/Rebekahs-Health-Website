# Separate generated/hosted application repository
/published-site/

# Local tooling dependencies (recreated by the package manager)
/.tools/node_modules/

# Keep large local/generated video files out of GitHub
*.mp4
*.m4v
*.mov
*.avi
*.webm
*.mbtree

# Recreated local media/tooling dependencies
/tools/pydeps/
/tools/yt-dlp.exe
/tmp/ffmpeg-extract/

# Generated WordPress release archives
/wordpress/dist/

# Private client account references (local only; never commit)
/PRIVATE-CLIENT-ACCESS.md
