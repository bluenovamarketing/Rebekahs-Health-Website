# Separate generated/hosted application repository
/published-site/

# Local tooling dependencies (recreated by the package manager)
/.tools/node_modules/
node_modules/

# Keep large local/generated video files out of GitHub
*.mp4
*.m4v
*.mov
*.avi
*.webm
*.mbtree

# Training-video production media is uploaded to the client Drive library.
# Keep only the editable source decks, scripts, written instructions, and QA records in Git.
/client-handoff/website-editing-instructions/**/audio/
/client-handoff/website-editing-instructions/**/voice-samples/
/client-handoff/website-editing-instructions/**/*-narrated.pptx
/client-handoff/website-editing-instructions/**/*-Narration-*.wav

# Training audio is generated from the retained scripts/decks and delivered through Drive.
/client-handoff/**/audio/
/client-handoff/**/*.wav
/client-handoff/**/work/__pycache__/

# Recreated local media/tooling dependencies
/tools/pydeps/
/tools/yt-dlp.exe
/tmp/ffmpeg-extract/

# Recreated local PHP/vendor test runtimes and generated deployment archives.
/tmp/php-8.5.11-rhn-20261004/
/tmp/flexible-shipping-usps-3.5.4-source/
/tmp/flexible-shipping-usps.3.5.4.zip
/tmp/rhn-catalog-presentation-*.zip

# Local checkout-rate captures can contain session cookies and are reproducible.
/tmp/usps-*-cookies.txt
/tmp/usps-*-cart*.html
/tmp/usps-*-pre.html
/tmp/usps-fresh-cart*.html

# Reproducible local language and media runtimes
/.tools/catalog-video-runtime/
/.tools/video-runtime/
/.tools/php-8.5.11/
/.tools/php-8.5.11-nts-Win32-vs17-x64.zip
/.tools/**/__pycache__/
/.tools/package-rhn-*/
/.tools/package-v*/
*.inspect.ndjson

# Generated WordPress release archives
/wordpress/dist/

# Private client account references (local only; never commit)
/PRIVATE-CLIENT-ACCESS.md

# Raw staging catalog snapshots remain local; reviewed findings are in project notes.
/client-inputs/phase-two/woocommerce-staging-export-*.csv

# Reproducible local review renders and validation caches
/scripts/__pycache__/

# Recreated Team Members source extraction and video render intermediates
/.tmp-team-profiles/
/client-handoff/team-members-video/audio/
/client-handoff/team-members-video/preview-frames/

# Local Codex finalization and private working state.
/.codex-finalizer/
/.codex-private/
/client-handoff/**/.codex-finalizer/
/client-handoff/**/work/.deck-build/
/client-handoff/**/work/python-packages/

# Local/generated catalog exports and analysis evidence. Keep these on the
# workstation; do not expose private catalog snapshots or generated copies in Git.
/tmp/
/outputs/
/artifacts/
/evidence/catalog/
/client-inputs/**/*.csv
/client-inputs/**/*.xlsx

# Reproducible review renders. Retain editable scripts, decks, captions, and
# written QA records while excluding generated frame sequences and previews.
/output/*.png
/client-handoff/**/qa-frames/
/client-handoff/**/final-preview/
/client-handoff/**/slides/
/client-handoff/**/work/**/*.png
/client-handoff/**/work/tmp/

# Reproducible audit output and packaged WordPress release archives. Source
# scripts and unpacked plugin directories remain eligible for version control.
/.tools/*-result.json
/.tools/*-preview.png
/.tools/*.zip
/wordpress/plugins/*.zip
